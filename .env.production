// api/.env.production
NODE_ENV=production
PORT=5000

# MongoDB (from Atlas)
MONGODB_URI=mongodb+srv://empathica_admin:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/empathica?retryWrites=true&w=majority

# JWT
JWT_SECRET=generate-a-strong-random-secret-key-here
JWT_EXPIRE=7d

# AI Service
AI_SERVICE_URL=https://your-ai-service.hf.space
AI_API_KEY=generate-secure-api-key

# Frontend URL
CLIENT_URL=https://empathica.vercel.app

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password